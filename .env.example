# =====================================================
# S4E MCP Server — copy to .env and customize
# Tokens are NEVER stored — clients pass S4E-API-Token per request.
# =====================================================

# Environment label (shown in logs and /health)
S4E_ENV=local

# Upstream S4E API (required)
S4E_API_URL=https://api.s4e.io/api

# Dashboard links in tool output (optional, defaults to https://app.s4e.io)
APP_URL=https://app.s4e.io

# HTTP server bind (npm run dev / node directly)
MCP_HOST=0.0.0.0
MCP_PORT=8787

# Uncomment for verbose /mcp request logging (token values are never logged)
# MCP_DEBUG=1

# Self-signed HTTPS: only on trusted LAN — set to 0 for real CAs
S4E_TLS_INSECURE=1
